{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "YOUTUBE_API_KEY",
    "GOOGLE_CLIENT_ID",
    "VITE_YOUTUBE_API_KEY",
    "VITE_GOOGLE_CLIENT_ID"
  ],
  "tasks": {
    "dev": {
      "dependsOn": ["^dev"],
      "persistent": true,
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    }
  }
}

